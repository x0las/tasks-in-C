/* 1. Объявить массив из 5–7 целых чисел и вывести все его элементы на экран. */

#include <stdio.h>

int main() {
	int arr[] = {10, 20, 30, 40, 50};
	int n = sizeof(arr) / sizeof(arr[0]);
	
	for (int i = 0; i < n; i++) {
		printf("%d ", arr[i]);
	}
	return 0;
}

/* 2. Сумма элементов массива. */

#include <stdio.h>

int main() {
    int arr[] = {1, 2, 3, 4, 5};
    int n = sizeof(arr) / sizeof(arr[0]);
    int sum = 0;

    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }

    printf("Sum = %d\n", sum);
    return 0;
}

/* 3. Среднее арифметическое. */

#include <stdio.h>

int main() {
    int arr[] = {1, 2, 3, 4, 5, 6};
    int n = sizeof(arr) / sizeof(arr[0]);
    long long sum = 0;

    for (int i = 0; i < n; i++) {
        sum += arr[i];
    }

    double avg = (double)sum / n;
    printf("Average = %.2f\n", avg);
    return 0;
}

/* 4. Максимальный элемент. */

#include <stdio.h>

int main() {
    int arr[] = {3, 9, 2, 7, 5};
    int n = sizeof(arr) / sizeof(arr[0]);
    int max = arr[0];

    for (int i = 1; i < n; i++) {
        if (arr[i] > max) {
            max = arr[i];
        }
    }

    printf("Max = %d\n", max);
    return 0;
}

/* 5. Максимальный элемент. */

#include <stdio.h>

int main() {
    int arr[] = {8, 3, 1, 9, 4};
    int n = sizeof(arr) / sizeof(arr[0]);
    int min = arr[0];
    int min_index = 0;

    for (int i = 1; i < n; i++) {
        if (arr[i] < min) {
            min = arr[i];
            min_index = i;
        }
    }

    printf("Min = %d, index = %d\n", min, min_index);
    return 0;
}

/* 6. Количество чётных элементов. */

#include <stdio.h>

int main() {
    int arr[] = {1, 2, 3, 4, 5, 6, 7};
    int n = sizeof(arr) / sizeof(arr[0]);
    int count_even = 0;

    for (int i = 0; i < n; i++) {
        if (arr[i] % 2 == 0) {
            count_even++;
        }
    }

    printf("Even count = %d\n", count_even);
    return 0;
}
