/* Вывести числа от 1 до 10. */

#include <stdio.h>

int main() {
    for (int i = 1; i <= 10; i++) {
        printf("%d ", i);
    }

    return 0;
}

/* Вывести все четные числа от 2 до 20. */

#include <stdio.h>

int main() {
    for (int i = 2; i <= 20; i += 2) {
        printf("%d ", i);
    }

    return 0;
}

/* Ввести число N и найти сумму всех чисел от 1 до N. */

#include <stdio.h>

int main() {
    int n, sum = 0;
    scanf("%d", &n);

    for (int i = 1; i <= n; i++) {
        sum += i;
    }

    printf("Сумма = %d", sum);

    return 0;
}

/* Ввести число и вывести его таблицу умножения от 1 до 10. */

#include <stdio.h>

int main() {
    int n;
    scanf("%d", &n);

    for (int i = 1; i <= 10; i++) {
        printf("%d * %d = %d\n", n, i, n * i);
    }

    return 0;
}

/* Вывести числа от 10 до 1, а затем написать "Старт!" */

#include <stdio.h>

int main() {
    for (int i = 10; i >= 1; i--) {
        printf("%d ", i);
    }

    printf("\nСтарт!");

    return 0;
}

/* Вывести квадраты чисел от 1 до 10. */

#include <stdio.h>

int main() {
    for (int i = 1; i <= 10; i++) {
        printf("%d ", i * i);
    }

    return 0;
}

/* Ввести пять чисел и найти их сумму. */

#include <stdio.h>

int main() {
    int n, sum = 0;

    for (int i = 1; i <= 5; i++) {
        scanf("%d", &n);
        sum += n;
    }

    printf("Сумма = %d", sum);

    return 0;
}

/* Вводить числа, пока пользователь не введет 0. Посчитать количество введенных чисел, не считая ноль. */

#include <stdio.h>

int main() {
    int n, count = 0;

    scanf("%d", &n);

    while (n != 0) {
        count++;
        scanf("%d", &n);
    }

    printf("Количество = %d", count);

    return 0;
}
