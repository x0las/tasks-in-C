/* Создать функцию, которая выводит сообщение "Привет, мир!". */

#include <stdio.h>

void hello() {
    printf("Привет, мир!");
}

int main() {
    hello();

    return 0;
}

/* Создать функцию, которая принимает два числа и возвращает их сумму. */

#include <stdio.h>

int sum(int a, int b) {
    return a + b;
}

int main() {
    int a, b;
    scanf("%d %d", &a, &b);

    printf("Сумма = %d", sum(a, b));

    return 0;
}

/* Создать функцию, которая принимает число и возвращает его квадрат. */

#include <stdio.h>

int square(int n) {
    return n * n;
}

int main() {
    int n;
    scanf("%d", &n);

    printf("Квадрат = %d", square(n));

    return 0;
}

/* Создать функцию, которая проверяет, является ли число чётным. */

#include <stdio.h>

int even(int n) {
    return n % 2 == 0;
}

int main() {
    int n;
    scanf("%d", &n);

    if (even(n)) {
        printf("Четное");
    } else {
        printf("Нечетное");
    }

    return 0;
}

/* Создать функцию, которая возвращает большее из двух чисел. */

#include <stdio.h>

int maximum(int a, int b) {
    if (a > b) {
        return a;
    } else {
        return b;
    }
}

int main() {
    int a, b;
    scanf("%d %d", &a, &b);

    printf("Максимум = %d", maximum(a, b));

    return 0;
}

/* Создать функцию, которая вычисляет факториал числа N. Например, 5! = 120. */

#include <stdio.h>

int factorial(int n) {
    int result = 1;

    for (int i = 1; i <= n; i++) {
        result *= i;
    }

    return result;
}

int main() {
    int n;
    scanf("%d", &n);

    printf("Факториал = %d", factorial(n));

    return 0;
}

/* Создать функцию, которая находит сумму всех чисел от 1 до N. */

#include <stdio.h>

int sumN(int n) {
    int sum = 0;

    for (int i = 1; i <= n; i++) {
        sum += i;
    }

    return sum;
}

int main() {
    int n;
    scanf("%d", &n);

    printf("Сумма = %d", sumN(n));

    return 0;
}

/* Создать функцию, которая проверяет, является ли число положительным. */

#include <stdio.h>

int positive(int n) {
    return n > 0;
}

int main() {
    int n;
    scanf("%d", &n);

    if (positive(n)) {
        printf("Положительное число");
    } else {
        printf("Число не положительное");
    }

    return 0;
}

/* Создать функцию, которая принимает длину стороны квадрата и возвращает его периметр. */

#include <stdio.h>

int perimeter(int a) {
    return 4 * a;
}

int main() {
    int a;
    scanf("%d", &a);

    printf("Периметр = %d", perimeter(a));

    return 0;
}

/* Создать функцию, которая выводит все числа от 1 до N. */

#include <stdio.h>

void printNumbers(int n) {
    for (int i = 1; i <= n; i++) {
        printf("%d ", i);
    }
}

int main() {
    int n;
    scanf("%d", &n);

    printNumbers(n);

    return 0;
}
